+import hashlib,json,os,tempfile,unittest
+from pathlib import Path
+from unittest.mock import patch
+import history
+
+class HistoryReuseTests(unittest.TestCase):
+ def test_repeat_snapshot_never_creates_payload_temp(self):
+  with tempfile.TemporaryDirectory() as d:
+   root=Path(d);source=root/'data';source.write_bytes(b'payload');archive=root/'archive'
+   first=history.snapshot('id',[source],archive)
+   with patch.object(history.tempfile,'mkstemp',side_effect=AssertionError('No duplicate copy allowed')):
+    self.assertEqual(first,history.snapshot('id',[source],archive))
+ def test_corrupt_object_rejected_not_overwritten(self):
+  with tempfile.TemporaryDirectory() as d:
+   root=Path(d);source=root/'data';source.write_bytes(b'payload');archive=root/'archive'
+   history.snapshot('id',[source],archive)
+   obj=archive/'objects'/hashlib.sha256(b'payload').hexdigest();obj.write_bytes(b'corrupt')
+   with self.assertRaises(ValueError):history.snapshot('id',[source],archive)
+   self.assertEqual(obj.read_bytes(),b'corrupt')
+ def test_object_symlink_rejected(self):
+  with tempfile.TemporaryDirectory() as d:
+   root=Path(d);source=root/'data';source.write_bytes(b'payload');archive=root/'archive'
+   history.snapshot('id',[source],archive)
+   obj=archive/'objects'/hashlib.sha256(b'payload').hexdigest();obj.unlink();obj.symlink_to(source)
+   with self.assertRaises(ValueError):history.snapshot('id',[source],archive)
+ def test_changed_source_before_copy_preserved_and_rejected(self):
+  with tempfile.TemporaryDirectory() as d:
+   root=Path(d);source=root/'data';source.write_bytes(b'payload');archive=root/'archive'
+   original=history.tempfile.mkstemp
+   def change(*args,**kwargs):
+    source.write_bytes(b'changed');return original(*args,**kwargs)
+   with patch.object(history.tempfile,'mkstemp',side_effect=change):
+    with self.assertRaises(RuntimeError):history.snapshot('id',[source],archive)
+   self.assertEqual(source.read_bytes(),b'changed');self.assertEqual(list((archive/'objects').iterdir()),[])
+ def test_cache_shared_inode_and_mutation_invalidates(self):
+  with tempfile.TemporaryDirectory() as d:
+   p=Path(d)/'a';p.write_bytes(b'one');q=Path(d)/'b';os.link(p,q);cache={}
+   first,_=history._verified_hash(p,cache);history._verified_hash(q,cache);self.assertEqual(len(cache),1)
+   p.write_bytes(b'two');second,_=history._verified_hash(q,cache);self.assertNotEqual(first,second)
+
+if __name__=='__main__':unittest.main()
